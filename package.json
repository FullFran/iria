{
  "name": "pifran",
  "version": "0.1.0",
  "description": "Fran's personal Pi coding agent: an isolated Pi home plus a bundled package of extensions, themes, prompts and skills.",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "pi-package"
  ],
  "bin": {
    "pifran": "bin/pifran.mjs"
  },
  "files": [
    "bin",
    "extensions",
    "themes",
    "prompts",
    "skills",
    "README.md"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "1.5.0"
  },
  "pi": {
    "extensions": [
      "./extensions"
    ],
    "themes": [
      "./themes"
    ],
    "prompts": [
      "./prompts"
    ],
    "skills": [
      "./skills"
    ]
  }
}
